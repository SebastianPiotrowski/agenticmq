# Broker Connection Configuration
AGENTICMQ_HOST=127.0.0.1
AGENTICMQ_PORT=8080

# State Directory Configuration
AGENTICMQ_STATE_DIR=.agenticmq_state

# Default Rate Limits (TPM / RPM)
AGENTICMQ_DEFAULT_GPT4O_TPM=30000
AGENTICMQ_DEFAULT_GPT4O_RPM=20
AGENTICMQ_DEFAULT_GPT4O_MINI_TPM=150000
AGENTICMQ_DEFAULT_GPT4O_MINI_RPM=100
AGENTICMQ_DEFAULT_CLAUDE_SONNET_TPM=40000
AGENTICMQ_DEFAULT_CLAUDE_SONNET_RPM=25

# Logging level (error, warn, info, debug, trace)
RUST_LOG=info
